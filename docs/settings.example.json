{
  "theme": "auto",
  "terminal": {
    "font_size": 14,
    "font_family": "Menlo",
    "line_height": 1.3,
    "cursor_shape": "block",
    "option_as_meta": true,
    "copy_on_select": false,
    "keep_selection_on_copy": true,
    "max_scroll_history_lines": 10000,
    "scroll_multiplier": 3.0,
    "minimum_contrast": 45.0,
    "blinking": "terminal_controlled",
    "alternate_scroll": "on",
    "bell": "off"
  }
}
