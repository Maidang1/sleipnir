{
  "theme": "auto",
  "restore_session": true,
  "confirm_close": "dirty",
  "path_links": true,
  "background_opacity": 1.0,
  "notify_on_command_finish_secs": 5,
  "notify_on_command_finish_mode": "unfocused",
  "custom_theme": {
    "background": "#0d1117",
    "foreground": "#e6edf3",
    "bright_foreground": "#ffffff",
    "cursor": "#e6edf3",
    "selection": "#264f78",
    "ansi": [
      "#484f58", "#ff7b72", "#3fb950", "#d29922",
      "#58a6ff", "#bc8cff", "#39c5cf", "#b1bac4",
      "#6e7681", "#ffa198", "#56d364", "#e3b341",
      "#79c0ff", "#d2a8ff", "#56d4dd", "#ffffff"
    ]
  },
  "key_bindings": [
    {
      "key": "cmd-alt-t",
      "action": "new_tab"
    }
  ],
  "terminal": {
    "font_size": 14,
    "font_family": "Menlo",
    "font_ligatures": false,
    "line_height": 1.3,
    "cursor_shape": "block",
    "option_as_meta": true,
    "copy_on_select": false,
    "keep_selection_on_copy": true,
    "max_scroll_history_lines": 10000,
    "scroll_multiplier": 3.0,
    "minimum_contrast": 45.0,
    "blinking": "terminal_controlled",
    "alternate_scroll": "on",
    "bell": "off",
    "inject_osc133": false
  }
}
